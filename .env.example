# Ambiente: use "production" apenas com segredos reais e origens HTTPS explicitas.
APP_ENV=development

# Banco de dados PostGIS
PG_HOST=localhost
PG_PORT=5433
PG_DB=ImobiliariaDB
PG_USER=admin
PG_PASS=troque-esta-senha

# Seguranca da API: gere uma chave longa e aleatoria antes de publicar.
JWT_SECRET=troque-por-uma-chave-longa-e-aleatoria
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Cidade analisada
CITY_NAME=Pouso Alegre, Minas Gerais, Brazil
CITY_LAT=-22.230278
CITY_LON=-45.948889
CITY_IBGE_CODE=3152501
H3_RES=8

# Servicos opcionais
MLFLOW_TRACKING_URI=http://localhost:5000
MODEL_PATH=models/price_model.joblib

# Opcional: amplia limites/validade de token no Planetary Computer.
PC_SDK_SUBSCRIPTION_KEY=

# Opcional: habilita a camada adicional de tempo real de deslocamento
# (mapbox_access.py). Sem token, a camada fica indisponivel e o score
# calibrado continua funcionando normalmente com distancia em linha reta.
MAPBOX_TOKEN=
