# Copie este arquivo para .env e preencha os valores
# cp .env.example .env

# ── PostgreSQL ──────────────────────────────────────────────────────────────
# Local dev → localhost:5432  |  Docker → PG_HOST=db, PG_PORT=5432
PG_HOST=localhost
PG_PORT=5432
PG_DB=ImobiliariaDB
PG_USER=admin
PG_PASS=admin123

# ── Cidade ──────────────────────────────────────────────────────────────────
CITY_NAME=Pouso Alegre, Minas Gerais, Brazil
CITY_LAT=-22.230278
CITY_LON=-45.948889
H3_RES=8

# ── MLflow ───────────────────────────────────────────────────────────────────
# Local dev → http://localhost:5000  |  Docker → http://mlflow:5000
MLFLOW_TRACKING_URI=http://localhost:5000

# ── API ──────────────────────────────────────────────────────────────────────
MODEL_PATH=models/price_model.joblib

# ── MinIO ────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=gpminio
MINIO_ROOT_PASSWORD=gpminio123

# ── PgAdmin ──────────────────────────────────────────────────────────────────
PGADMIN_DEFAULT_EMAIL=admin@local
PGADMIN_DEFAULT_PASSWORD=admin

# ── Sentinel / Planetary Computer (opcional) ─────────────────────────────────
# Necessário apenas se o endpoint exigir autenticação
# ML_ACCESS_TOKEN=
