# Copie para .env.prod e substitua todos os valores CHANGE_ME antes do deploy.
APP_ENV=production

# Imagens publicadas no Docker Hub.
DOCKERHUB_NAMESPACE=alvarocareli
IMAGE_TAG=latest

PG_DB=ImobiliariaDB
PG_USER=urbia
PG_PASS=CHANGE_ME_DATABASE_PASSWORD

JWT_SECRET=CHANGE_ME_WITH_AT_LEAST_48_RANDOM_CHARACTERS
# E-mails (separados por vírgula) que podem disparar o pipeline de dados.
ADMIN_EMAILS=admin@seudominio.com.br
CORS_ORIGINS=https://urbia.example.com

DOMAIN=urbia.example.com
ACME_EMAIL=admin@example.com

MINIO_ROOT_USER=urbia-storage
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD

MODEL_PATH=models/price_model.joblib
HF_TOKEN=
MLFLOW_TRACKING_URI=http://mlflow:5000

CITY_NAME=Pouso Alegre, Minas Gerais, Brazil
CITY_LAT=-22.230278
CITY_LON=-45.948889
H3_RES=8
