# Copy to an ignored file outside the repository; replace all values.
# Never use these example values on a public server.
DOMAIN=demo.example.invalid
ACME_EMAIL=operator@example.invalid
PG_DB=urbia_partner
PG_USER=urbia_partner
PG_PASS=REPLACE_WITH_A_RANDOM_DATABASE_PASSWORD
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ADMIN_EMAILS=operator@example.invalid
DEMO_HTTP_PORT=80
DEMO_HTTPS_PORT=443
DEMO_REGISTRATION_CODE=REPLACE_WITH_A_PRIVATE_RANDOM_INVITATION_CODE
DEMO_ALLOWED_EMAILS=
# Image generation: set a private provider token before validating this feature.
# Keep the token only in the private server environment file.
HF_TOKEN=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
HF_IMAGE_PROVIDER=auto
HF_DAILY_IMAGE_LIMIT=8
